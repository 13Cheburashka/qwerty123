// ── Progs Tab ──────────────────────────────────────────
function ProgsTab({atkP,defP,utlP,isOwn,onAdd,onEdit,onDel,onCycle,onAtk}){
  const total=atkP.length+defP.length+utlP.length;
  const [open,setOpen]=useState({attacking:true,defensive:true,support:true});
  const toggle=k=>setOpen(o=>({...o,[k]:!o[k]}));
  return<div>
    <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:16}}>
      <span style={{fontSize:13,color:TX2}}>Установлено: {total}</span>
      {isOwn&&<button onClick={onAdd} style={{...SB(C.cyl,C.cyl,{fontSize:13,padding:'7px 18px',letterSpacing:2})}}>+ УСТАНОВИТЬ (своя программа)</button>}
    </div>
    {atkP.length>0&&<><SH c={C.rdl} l={`АТАКУЮЩИЕ (${atkP.length})`} mt={false} open={open.attacking} onClick={()=>toggle('attacking')}/>
      {open.attacking&&atkP.map(p=><PC key={p.id} prog={p} isOwn={isOwn} onEdit={onEdit} onDel={onDel} onCycle={onCycle} onAtk={onAtk}/>)}</>}
    {defP.length>0&&<><SH c={C.cyl} l={`ЗАЩИТНЫЕ (${defP.length})`} mt={atkP.length>0} open={open.defensive} onClick={()=>toggle('defensive')}/>
      {open.defensive&&defP.map(p=><PC key={p.id} prog={p} isOwn={isOwn} onEdit={onEdit} onDel={onDel} onCycle={onCycle} onAtk={null}/>)}</>}
    {utlP.length>0&&<><SH c={C.aml} l={`ВСПОМОГАТЕЛЬНЫЕ (${utlP.length})`} mt={atkP.length>0||defP.length>0} open={open.support} onClick={()=>toggle('support')}/>
      {open.support&&utlP.map(p=><PC key={p.id} prog={p} isOwn={isOwn} onEdit={onEdit} onDel={onDel} onCycle={onCycle} onAtk={null}/>)}</>}
    {total===0&&<div style={{fontSize:14,color:TX2,padding:'24px 0'}}>// Кибердека пуста</div>}
  </div>;
}
function SH({c,l,mt,open,onClick}){
