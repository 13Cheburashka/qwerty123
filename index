      return<div key={bug.id} style={{background:act?'rgba(238,68,85,0.1)':C.pan2,border:'1px solid '+(act?C.rdl+'66':C.brd),padding:'10px 14px',marginBottom:7,display:'flex',alignItems:'center',gap:14,transition:'all 0.2s'}}>
        <div style={{fontSize:16,color:act?C.rdl:TX2,minWidth:26,fontWeight:'bold',flexShrink:0}}>#{bug.id}</div>
        <div style={{flex:1,minWidth:0}}>
          <div style={{display:'flex',alignItems:'baseline',gap:10,flexWrap:'wrap'}}>
            <span style={{fontSize:17,color:act?C.rdll:C.txb,fontWeight:act?'bold':'normal'}}>{bug.label}</span>
            <span style={{fontSize:15,color:act?C.rdl+'cc':TX2,whiteSpace:'normal'}}>{bug.desc}</span>
            {bug.numeric&&act&&cnt>0&&<span style={{fontSize:15,color:C.rdl}}>({bug.mult*cnt>0?'+':''}{bug.mult*cnt})</span>}
          </div>
        </div>
        <div style={{display:'flex',alignItems:'center',gap:8,flexShrink:0}}>
          {isOwn?<>
            <button onClick={()=>onBug(bug.id,cnt-1)} style={{...SB(C.brd,C.txb,{padding:'3px 12px',fontSize:19,lineHeight:1})}}>−</button>
            <span style={{fontFamily:C.or,fontSize:22,color:act?C.rdl:TX2,minWidth:28,textAlign:'center'}}>{cnt||'—'}</span>
            <button onClick={()=>onBug(bug.id,cnt+1)} style={{...SB(act?C.rdl:C.brd,act?C.rdl:C.txb,{padding:'3px 12px',fontSize:19,lineHeight:1})}}>+</button>
          </>:<span style={{fontFamily:C.or,fontSize:22,color:act?C.rdl:TX2,minWidth:28,textAlign:'center'}}>{cnt||'—'}</span>}
        </div>
      </div>;
    })}
  </div>;
