    </div>
    <div style={{padding:22,display:'flex',flexDirection:'column',gap:16}}>
      <FL label="Название программы"><input value={p.name} onChange={e=>s('name',e.target.value)} placeholder="Собственная программа..." style={SI({fontSize:16})}/></FL>
      <FL label="Категория"><div style={{display:'flex',gap:10}}>
        {Object.entries(CATL).map(([k,v])=><button key={k} onClick={()=>s('category',k)} style={{...SB(p.category===k?CATC[k]:C.brd,p.category===k?CATC[k]:TX2,{flex:1,padding:'9px 4px',fontSize:13,letterSpacing:1})}}>{v}</button>)}
      </div></FL>
      <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:14}}>
        <FL label="Цена (eb)"><input value={p.price} onChange={e=>s('price',e.target.value)} placeholder={hp} style={SI()}/></FL>
        <FL label="Память (MU)"><input value={p.mu} onChange={e=>s('mu',e.target.value)} placeholder="2" style={SI()}/></FL>
      </div>

      <div style={{background:C.pan2,border:'1px solid '+C.brdl,padding:14}}>
        <div style={{fontSize:12,color:C.aml,letterSpacing:2,marginBottom:6}}>МОДИФИКАТОРЫ КРИТИЧЕСКИХ ПОРОГОВ</div>
        <div style={{fontSize:12,color:TX2,marginBottom:12}}>{p.category==='attacking'?'⚠ Только для этой программы. Не влияет на общий порог деки.':'Влияют на глобальный порог деки (все атакующие программы).'}</div>
        <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:14}}>
          <FL label="Порог Крита (мод)"><input value={p.crit_mod} onChange={e=>s('crit_mod',e.target.value)} placeholder="+1 / -2" style={SI()}/></FL>
          <FL label="Порог Провала (мод)"><input value={p.fumble_mod} onChange={e=>s('fumble_mod',e.target.value)} placeholder="+1 / -1" style={SI()}/></FL>
        </div>
