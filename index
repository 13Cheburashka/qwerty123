  if(!entry.detail)return null;
  let p=null;try{p=JSON.parse(entry.detail);}catch{}
  if(!p)return<div style={{marginTop:5,marginLeft:8,paddingLeft:12,borderLeft:'2px solid '+entry.color+'33',fontSize:13,color:TX2,lineHeight:1.7}}>{entry.detail}</div>;

  // Attack result
  if(entry.action.startsWith('⚔ АТАКА')){
    const isCrit=p.isCrit,isFum=p.isFum;
    return<div style={{marginTop:7,marginLeft:6,paddingLeft:10,borderLeft:'2px solid '+entry.color+'44'}}>
      <div style={{display:'flex',flexWrap:'wrap',gap:14,marginBottom:6}}>
        <div>
          <div style={{fontSize:10,color:TX2,letterSpacing:2,marginBottom:3}}>ПОПАДАНИЕ</div>
          <span style={{fontFamily:C.or,fontSize:32,color:isCrit?C.amll:isFum?C.rdll:C.cyll,textShadow:'0 0 16px '+(isCrit?C.aml:isFum?C.rdl:C.cyl)+'77',lineHeight:1}}>{p.hitTotal}</span>
          {isCrit&&<div style={{fontSize:12,color:C.amll,fontWeight:'bold',marginTop:2}}>🔴 КРИТ!</div>}
          {isFum&&<div style={{fontSize:12,color:C.rdll,fontWeight:'bold',marginTop:2}}>⚫ ПРОВАЛ!</div>}
        </div>
        {p.dmgR&&<div>
          <div style={{fontSize:10,color:C.rdl,letterSpacing:2,marginBottom:3}}>УРОН/РАН</div>
          <span style={{fontFamily:C.or,fontSize:32,color:C.rdll,textShadow:'0 0 14px '+C.rdl+'66',lineHeight:1}}>{p.dmgR.total}</span>
        </div>}
        {p.dmgP&&<div>
          <div style={{fontSize:10,color:C.org,letterSpacing:2,marginBottom:3}}>УРОН/ПРГ</div>
          <span style={{fontFamily:C.or,fontSize:32,color:C.org,textShadow:'0 0 14px '+C.org+'66',lineHeight:1}}>{p.dmgP.total}</span>
        </div>}
      </div>
      <div style={{fontSize:11,color:TX2,lineHeight:1.6,wordBreak:'break-word'}}>{p.hitExpr}</div>
      {p.dmgR?.parts&&<div style={{fontSize:11,color:TX2,wordBreak:'break-word'}}>Ур/ран: {p.dmgR.parts.join(' ')}</div>}
      {p.dmgP?.parts&&<div style={{fontSize:11,color:TX2,wordBreak:'break-word'}}>Ур/прг: {p.dmgP.parts.join(' ')}</div>}
    </div>;
  }
  // Defense / Init / generic Roll — all share {total, expr}
  const LBL={'🛡 ЗАЩИТА':['ЗАЩИТА',C.gnll,C.gnl],'🎲 ИНИЦИАТИВА':['ИНИЦИАТИВА',C.cyll,C.cyl],'🎲 БРОСОК':['БРОСОК',C.org,C.org]};
  const meta=LBL[entry.action];
  if(meta&&p.total!==undefined){
    const[lb,fg,glow]=meta;
    return<div style={{marginTop:7,marginLeft:6,paddingLeft:10,borderLeft:'2px solid '+entry.color+'44'}}>
      <div style={{fontSize:10,color:TX2,letterSpacing:2,marginBottom:3}}>{lb}</div>
      <span style={{fontFamily:C.or,fontSize:34,color:fg,textShadow:'0 0 16px '+glow+'66',lineHeight:1}}>{p.total}</span>
      <div style={{fontSize:11,color:TX2,lineHeight:1.6,marginTop:4,wordBreak:'break-word'}}>{p.expr}</div>
    </div>;
  }
  return<div style={{marginTop:5,marginLeft:6,paddingLeft:10,borderLeft:'2px solid '+entry.color+'33',fontSize:13,color:TX2,lineHeight:1.7}}>{entry.detail}</div>;
}

function LogPanel({logs,logRef,onSendMsg}){
  const [width,setWidth]=useState(360);
  const [msg,setMsg]=useState('');
  const atBottomRef=useRef(true);

  useEffect(()=>{
    const el=logRef.current;
    if(!el)return;
    if(atBottomRef.current) el.scrollTop=el.scrollHeight;
  },[logs]);

  const onScroll=e=>{
    const el=e.currentTarget;
    atBottomRef.current=(el.scrollHeight-el.scrollTop-el.clientHeight)<60;
  };

  const onDragStart=e=>{
    e.preventDefault();
    const startX=e.clientX, startW=width;
    const onMove=ev=>{const delta=startX-ev.clientX;setWidth(Math.max(220,Math.min(window.innerWidth-260,startW+delta)));};
    const onUp=()=>{document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',onUp);};
    document.addEventListener('mousemove',onMove);
    document.addEventListener('mouseup',onUp);
  };

  const sendMsg=()=>{
    const txt=msg.trim();
    if(!txt||!onSendMsg)return;
    setMsg('');
    onSendMsg(txt);
  };

  return<div style={{background:C.pan,borderLeft:'1px solid '+C.brd,width,display:'flex',flexDirection:'column',flexShrink:0,position:'relative'}}>
    <div onMouseDown={onDragStart} style={{position:'absolute',top:0,bottom:0,left:0,width:6,cursor:'ew-resize',zIndex:10,display:'flex',alignItems:'center',justifyContent:'center'}}>
      <div style={{width:3,height:40,borderRadius:2,background:C.brdl,opacity:0.7}}/>
    </div>
    <div style={{padding:'10px 14px 10px 18px',borderBottom:'1px solid '+C.brd,flexShrink:0}}>
      <div style={{fontSize:12,color:C.aml,letterSpacing:3}}>// ЖУРНАЛ МАТРИЦЫ</div>
      <div style={{fontSize:12,color:TX2,marginTop:2}}>{logs.length}/{MAX_LOG} записей</div>
    </div>
    <div ref={logRef} onScroll={onScroll} style={{flex:1,overflowY:'auto',padding:'10px 12px',minHeight:0}}>
      {logs.length===0&&<div style={{fontSize:13,color:TX2,padding:'10px 0'}}>// ожидание активности...</div>}
      {logs.map(e=><div key={e.id} style={{marginBottom:9,padding:'7px 10px',borderLeft:'3px solid '+(e.type==='fumble'?C.rdl:e.type==='crit'?C.aml:e.type==='system'?C.cyl:e.color+'88'),background:'rgba(255,255,255,0.016)'}}>
        <div style={{display:'flex',flexDirection:'column',gap:2}}>
          <span style={{color:e.color,fontWeight:'bold',fontSize:14,overflowWrap:'break-word'}}>{e.from} <span style={{color:'#6a7e90',fontWeight:'normal',fontSize:11}}>[{e.t}]</span></span>
          <span style={{color:LTCOL[e.type]||C.txb,fontSize:13,overflowWrap:'break-word'}}>{e.action}</span>
        </div>
        {renderDetail(e)}
      </div>)}
    </div>
    {onSendMsg&&<div style={{padding:'8px 10px',borderTop:'1px solid '+C.brd,display:'flex',flexDirection:'column',gap:6,flexShrink:0}}>
      <input value={msg} onChange={e=>setMsg(e.target.value)} onKeyDown={e=>e.key==='Enter'&&sendMsg()}
        placeholder="Написать в лог..." style={{...SI({fontSize:14,padding:'6px 10px'})}}/>
      <button onClick={sendMsg} style={{...SB(C.aml,C.aml,{fontSize:13,padding:'6px 16px',width:'100%'})}}>▶ ПОСЛАТЬ</button>
    </div>}
  </div>;
}

// ══════════════════════════════════════════════════════
//   LIBRARY PANEL (view/install for all · edit for GM only)
// ══════════════════════════════════════════════════════
function LibraryPanel({onClose,onInstall,isGM}){
  const [cat,setCat]=useState('attacking');
  const [selId,setSelId]=useState(INIT_LIBRARY[0]?.id||null);
  const [mode,setMode]=useState('view');
  const [overrides,setOverrides]=useState({});
  const [editForm,setEditForm]=useState(null);
  const [toast,setToast]=useState('');
  const [search,setSearch]=useState('');

  useEffect(()=>{
    DB.get('cp20/library_overrides').then(v=>{ if(v)setOverrides(v); });
  },[]);

  // Effective library = built-ins patched by overrides, plus brand-new custom entries
  const library=(()=>{
    const base=INIT_LIBRARY.map(p=>overrides[p.id]?{...overrides[p.id]}:p);
    const customIds=Object.keys(overrides).filter(id=>!INIT_LIBRARY.find(ip=>ip.id===id));
    return[...base,...customIds.map(id=>overrides[id])];
  })();

  const showToast=msg=>{setToast(msg);setTimeout(()=>setToast(''),2200);};

  const filtered=library.filter(p=>p.category===cat&&(search===''||p.name.toLowerCase().includes(search.toLowerCase())));
  const sel=library.find(p=>p.id===selId);

  const handleInstall=(prog,v)=>{
    if(!onInstall){showToast('Установка недоступна для текущей цели');return;}
    onInstall(prog,v);
    showToast(`«${prog.name} v${v.v}» добавлена в лист!`);
  };

  const handleSaveCustom=async(form)=>{
    const next={...overrides,[form.id]:form};
    setOverrides(next);
    await DB.set('cp20/library_overrides',next);
    setSelId(form.id);setCat(form.category);setMode('view');
    showToast('Изменения сохранены — видно всем игрокам');
  };

  const handleDelete=async(id)=>{
    if(INIT_LIBRARY.find(p=>p.id===id)){showToast('Базовые программы нельзя удалить, только редактировать');return;}
    if(!window.confirm('Удалить программу из базы?'))return;
    const next={...overrides};delete next[id];
    setOverrides(next);
    await DB.set('cp20/library_overrides',next);
    const rem=library.filter(p=>p.id!==id&&p.category===cat);
    setSelId(rem[0]?.id||null);setMode('view');
    showToast('Программа удалена');
  };

  return<div style={{position:'fixed',inset:0,background:'rgba(0,0,0,0.93)',zIndex:200,display:'flex',fontFamily:C.fn}}>
    {toast&&<div style={{position:'absolute',top:18,left:'50%',transform:'translateX(-50%)',background:C.gnl,color:C.bg,padding:'8px 22px',fontSize:14,letterSpacing:1,zIndex:210,borderRadius:2}}>{toast}</div>}
    <div style={{display:'flex',width:'100%',height:'100%',overflow:'hidden'}}>
      <div style={{width:230,background:C.pan,borderRight:'1px solid '+C.brd,display:'flex',flexDirection:'column',flexShrink:0}}>
        <div style={{padding:'12px 14px',borderBottom:'1px solid '+C.brd,display:'flex',alignItems:'center',justifyContent:'space-between'}}>
          <div>
            <div style={{fontSize:14,color:C.gnl,letterSpacing:3,fontWeight:'bold'}}>NET_PROGRAMS</div>
            <div style={{fontSize:12,color:TX2,marginTop:2}}>{library.length} программ{!isGM&&' · только просмотр'}</div>
          </div>
          <button onClick={onClose} style={{background:'transparent',border:'none',color:TX2,cursor:'pointer',fontSize:22,lineHeight:1}}>✕</button>
        </div>
        <div style={{borderBottom:'1px solid '+C.brd}}>
          {Object.entries(LIBCAT_META).map(([k,m])=>{
            const cnt=library.filter(p=>p.category===k).length;
            const col={attacking:C.rdl,defensive:C.cyl,support:C.aml}[k];
            const active=cat===k;
            return<button key={k} onClick={()=>{setCat(k);setMode('view');}}
              style={{width:'100%',background:active?col+'18':'transparent',border:'none',borderLeft:active?'3px solid '+col:'3px solid transparent',
                color:active?col:TX2,fontFamily:C.fn,fontSize:14,padding:'10px 14px',cursor:'pointer',display:'flex',alignItems:'center',justifyContent:'space-between',textAlign:'left'}}>
              <span>{m.icon} {m.label}</span>
              <span style={{fontSize:12,color:active?col:TX2,background:C.pan2,padding:'1px 7px',borderRadius:2}}>{cnt}</span>
            </button>;
          })}
        </div>
        <div style={{padding:'8px 10px',borderBottom:'1px solid '+C.brd}}>
          <input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Поиск..." style={{...SI({fontSize:14,padding:'5px 9px'}),background:C.pan2}}/>
        </div>
        <div style={{flex:1,overflowY:'auto'}}>
          {filtered.map(p=>{
            const col={attacking:C.rdl,defensive:C.cyl,support:C.aml}[p.category];
            const active=selId===p.id&&mode==='view';
            const isBuiltIn=!!INIT_LIBRARY.find(ip=>ip.id===p.id);
            const isEdited=isBuiltIn&&!!overrides[p.id];
            return<button key={p.id} onClick={()=>{setSelId(p.id);setMode('view');}}
              style={{width:'100%',background:active?col+'18':C.pan,border:'none',borderBottom:'1px solid '+C.brd+'55',borderLeft:active?'3px solid '+col:'3px solid transparent',
                color:active?col:C.txb,fontFamily:C.fn,fontSize:15,padding:'9px 14px',cursor:'pointer',textAlign:'left',transition:'all 0.1s'}}>
              <div style={{fontWeight:active?'bold':'normal'}}>{p.name}{isEdited&&<span style={{color:C.aml,fontSize:11}}> ✎</span>}</div>
              <div style={{fontSize:12,color:TX2,marginTop:2}}>{p.versions.length} версий{!isBuiltIn?' · custom':''}</div>
            </button>;
          })}
        </div>
        {isGM&&<div style={{padding:10,borderTop:'1px solid '+C.brd}}>
          <button onClick={()=>{setMode('create');setEditForm({id:uid(),category:cat,name:'',description:'',versions:[{v:'1.0',mu:'',price:'',diff:''}]});}}
            style={{...SB(C.gnl,C.gnl,{width:'100%',padding:'8px',fontSize:14,letterSpacing:1})}}>
            + НОВАЯ ПРОГРАММА
          </button>
        </div>}
      </div>

      <div style={{flex:1,display:'flex',flexDirection:'column',overflow:'hidden',minWidth:0}}>
        {mode==='view'&&sel&&<LibDetail prog={sel} onInstall={handleInstall}
          isGM={isGM}
          onEdit={()=>{setEditForm(JSON.parse(JSON.stringify(sel)));setMode('edit');}}
          onDelete={()=>handleDelete(sel.id)} isBuiltIn={!!INIT_LIBRARY.find(ip=>ip.id===sel.id)}/>}
        {(mode==='create'||mode==='edit')&&editForm&&<LibForm form={editForm} setForm={setEditForm} onSave={handleSaveCustom} onCancel={()=>setMode('view')}/>}
        {mode==='view'&&!sel&&<div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',fontSize:16,color:TX2}}>Выберите программу</div>}
      </div>
    </div>
  </div>;
}

function LibDetail({prog,onInstall,onEdit,onDelete,isBuiltIn,isGM}){
  const cat=prog.category;
  const col={attacking:C.rdl,defensive:C.cyl,support:C.aml}[cat];
  const extraAll=LIBCAT_EXTRA[cat]||[];
  // only show columns that at least one version actually uses
  const extra=extraAll.filter(f=>prog.versions.some(v=>v[f]&&v[f]!=='' && v[f]!=='-'));
  const hasNotes=prog.versions.some(v=>(v.diff&&v.diff!=='-')||(v.effect&&v.effect!=='-'));
  const cols=[
    {k:'v',lb:'ВЕРСИЯ',w:70},
    {k:'mu',lb:'MU',w:56},
    {k:'price',lb:'ЦЕНА',w:82},
    ...extra.map(f=>({k:f,lb:LIBFIELD_LABELS[f],w:110})),
  ];
  return<div style={{flex:1,overflowY:'auto',display:'flex',flexDirection:'column'}}>
    <div style={{padding:'18px 24px',borderBottom:'1px solid '+C.brd,background:C.pan,flexShrink:0}}>
      <div style={{display:'flex',alignItems:'flex-start',justifyContent:'space-between',gap:12}}>
        <div style={{flex:1}}>
          <div style={{fontSize:12,color:col,letterSpacing:3,marginBottom:6}}>{LIBCAT_META[cat].icon} {LIBCAT_META[cat].label.toUpperCase()}</div>
          <div style={{fontFamily:C.or,fontSize:22,color:C.txb,letterSpacing:2}}>{prog.name}</div>
          {prog.description&&<div style={{fontSize:15,color:C.tx,marginTop:8,lineHeight:1.75,fontStyle:'italic',borderLeft:'2px solid '+C.brdl,paddingLeft:14,maxWidth:520}}>{prog.description}</div>}
        </div>
        {isGM&&<div style={{display:'flex',gap:7,flexShrink:0}}>
          <button onClick={onEdit} style={SB(C.brdl,C.tx,{fontSize:13,padding:'5px 14px'})}>✎ РЕДАКТ.</button>
          {!isBuiltIn&&<button onClick={onDelete} style={SB(C.rdl+'55',C.rdl,{fontSize:13,padding:'5px 14px'})}>✕ УДАЛИТЬ</button>}
        </div>}
      </div>
    </div>
    <div style={{flex:1,overflowX:'auto',padding:'18px 24px'}}>
      <table style={{width:'auto',borderCollapse:'collapse',fontSize:15,background:C.pan2}}>
        <thead>
          <tr>
            {cols.map(c=><th key={c.k} style={{textAlign:'left',padding:'9px 16px',borderBottom:'2px solid '+col,color:col,fontSize:12,letterSpacing:1,whiteSpace:'nowrap',background:C.pan3,position:'sticky',top:0}}>{c.lb}</th>)}
            {hasNotes&&<th style={{textAlign:'left',padding:'9px 16px',borderBottom:'2px solid '+col,color:col,fontSize:12,letterSpacing:1,background:C.pan3,position:'sticky',top:0}}>ОСОБЕННОСТИ / ЭФФЕКТ</th>}
            <th style={{padding:'9px 16px',borderBottom:'2px solid '+col,background:C.pan3,position:'sticky',top:0}}></th>
          </tr>
        </thead>
        <tbody>
          {prog.versions.map((v,i)=>(
            <tr key={i} style={{borderBottom:'1px solid '+C.brd}}>
              {cols.map(c=><td key={c.k} style={{padding:'11px 16px',color:c.k==='v'?col:C.txb,fontWeight:c.k==='v'?'bold':'normal',whiteSpace:'nowrap',verticalAlign:'top'}}>
                {c.k==='v'?'v'+v.v:(v[c.k]||'—')}
              </td>)}
              {hasNotes&&<td style={{padding:'11px 16px',color:C.tx,lineHeight:1.75,fontSize:14,minWidth:220,maxWidth:320}}>
                {[v.diff,v.effect].filter(x=>x&&x!=='-').join(' · ')||'—'}
              </td>}
              <td style={{padding:'8px 14px',verticalAlign:'top'}}>
                <button onClick={()=>onInstall(prog,v)} style={{...SB(col,col,{fontSize:12,padding:'6px 14px',letterSpacing:1,whiteSpace:'nowrap'})}}>▶ УСТАНОВИТЬ</button>
              </td>
            </tr>
          ))}
        </tbody>
