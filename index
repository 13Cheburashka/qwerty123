function RenameField({value,onChange,color}){
  const [ed,setEd]=useState(false);const [v,setV]=useState(value||'');
  useEffect(()=>setV(value||''),[value]);
  const commit=()=>{setEd(false);if(v.trim()&&v!==value)onChange(v.trim());else setV(value||'');};
  if(ed)return<input autoFocus value={v} onChange={e=>setV(e.target.value)} onBlur={commit}
    onKeyDown={e=>{if(e.key==='Enter')commit();if(e.key==='Escape'){setV(value||'');setEd(false);}}}
    style={{...SI({fontSize:19,padding:'3px 8px',width:220}),fontFamily:C.or,color,letterSpacing:2}}/>;
  return<span onClick={()=>setEd(true)} title="Нажмите чтобы переименовать" style={{fontFamily:C.or,fontSize:19,color,letterSpacing:2,cursor:'pointer',borderBottom:'1px dashed '+color+'66'}}>{value} <span style={{fontSize:12,color:TX2}}>✎</span></span>;
}

// ── Profile Sheet (used for both players AND demon mobs) ──
function Sheet({profile,isOwn,badge,onStat,onDeck,onAdd,onEdit,onDel,onCycle,onAtk,onBug,onRename,onHp}){
  const [tab,setTab]=useState('deck');
  const progs=(profile.programs||[]).filter(p=>p&&(p.category==='attacking'||p.category==='defensive'||p.category==='support'));
  const bugs=profile.bugs||defBugs();
  const usedMu=progs.reduce((s,p)=>{const n=+p.mu;return s+(isNaN(n)?0:n);},0);
  const totMu=+profile.cyberdeck?.memory||0;
  const ovf=totMu>0&&usedMu>totMu;
  const gCrit=globalCrit(progs),gFum=globalFumble(progs,bugs);
  const defVal=defenseValue(profile.stats,progs,bugs);
  const defBonus=defenseBonus(progs,bugs);
  const spd=calcSpeed(profile.stats,progs,bugs);
  const atkP=progs.filter(p=>p.category==='attacking');
  const defP=progs.filter(p=>p.category==='defensive');
  const utlP=progs.filter(p=>p.category==='support');
  const abCnt=BUGS.filter(b=>(bugs[b.id]||0)>0).length;
  const tabs=[{id:'deck',lb:'КИБЕРДЕКА'},{id:'progs',lb:`ПРОГРАММЫ(${progs.length})`},{id:'bugs',lb:`БАГИ${abCnt?' ['+abCnt+']':''}`}];
