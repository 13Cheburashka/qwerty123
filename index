// ══════════════════════════════════════════════════════
//   APP
// ══════════════════════════════════════════════════════
function App(){
  const [phase,setPhase]=useState('boot');
  const [myId,setMyId]=useState(null);
  const [myP,setMyP]=useState(null);
  const [roster,setRoster]=useState([]);
  const [sel,setSel]=useState(null); // {type:'player'|'blackice'|'demon', id}
  const [logs,setLogs]=useState([]);
  const [modal,setModal]=useState(null);
  const [showLib,setShowLib]=useState(false);
  const logRef=useRef(null);
  const unsubs=useRef([]);

  useEffect(()=>{
    (async()=>{
      const id=LS_GET('cp20_myid');
      if(id){
        const p=await DB.get('cp20/profiles/'+id);
        if(p){boot(id,p);return;}
      }
      setPhase('login');
    })();
    return()=>unsubs.current.forEach(f=>f?.());
  },[]);

  const boot=(id,p)=>{
    setMyId(id);setMyP(p);setSel({type:'player',id});setPhase('main');
    unsubs.current.push(
      DB.sub('cp20/roster',val=>{
        if(!val)return;
        const ids=Array.isArray(val)?val.filter(Boolean):[...new Set(Object.values(val))];
        Promise.all(ids.map(i=>DB.get('cp20/profiles/'+i))).then(prs=>{
          const v=prs.filter(Boolean);
          setRoster(v);
          const m=v.find(x=>x.id===id);
          if(m)setMyP(m);
        });
      }),
      DB.sub('cp20/logs',val=>{
        if(!val)return;
        const arr=(Array.isArray(val)?val:Object.values(val)).filter(Boolean);
        setLogs(arr.slice(-MAX_LOG));
      })
    );
  };

  const saveP=async p=>{
    await DB.set('cp20/profiles/'+p.id,p);
    const cur=await DB.get('cp20/roster')||[];
    const ids=Array.isArray(cur)?cur:Object.values(cur);
    if(!ids.includes(p.id))await DB.set('cp20/roster',[...ids,p.id]);
    if(p.id===myId)setMyP(p);
    setRoster(r=>{const i=r.findIndex(x=>x.id===p.id);if(i>=0){const n=[...r];n[i]=p;return n;}return[...r,p];});
  };

  const addLog=async(action,pr,detail,type='info')=>{
    const p=pr||myP;if(!p)return;
    const prev=await DB.get('cp20/logs')||[];
    const arr=(Array.isArray(prev)?prev:Object.values(prev)).filter(Boolean);
    const e={id:uid(),from:p.handle,color:p.color,action,detail:detail||'',type,t:ts()};
    const next=[...arr,e].slice(-MAX_LOG);
    await DB.set('cp20/logs',next);
    setLogs(next);
  };

  const onLogin=async({handle,color,isGM})=>{
    const accountKey=isGM?'__GM__':color.replace('#','').toLowerCase();
    const existingId=await DB.get('cp20/colormap/'+accountKey);
    let p=existingId?await DB.get('cp20/profiles/'+existingId):null;
    if(p){
      if(p.handle!==handle){p={...p,handle};await DB.set('cp20/profiles/'+p.id,p);}
      LS_SET('cp20_myid',p.id);
      await addLog(`ПОДКЛЮЧИЛСЯ (${isGM?'GM':color})`,p,'','system');
      boot(p.id,p);
    } else {
      const id=isGM?'GM_ACCOUNT':uid();
      p={id,handle,color:isGM?'#ee4455':color,isGM,
        stats:{int:'',iface:''},cyberdeck:{name:'',memory:'',speed_raw:'',defense:''},
        programs:[],bugs:defBugs()};
      await DB.set('cp20/colormap/'+accountKey,id);
      LS_SET('cp20_myid',id);
      await saveP(p);
      await addLog('СОЗДАЛ АККАУНТ И ПОДКЛЮЧИЛСЯ',p,'','system');
      boot(id,p);
    }
  };

  const onLogout=async()=>{
    if(myP)await addLog('ОТКЛЮЧИЛСЯ',myP,'','system');
    LS_SET('cp20_myid',null);
    unsubs.current.forEach(f=>f?.());
    setPhase('login');setMyId(null);setMyP(null);setRoster([]);setSel(null);setLogs([]);
  };

  // ── Mobs (loaded for GM only) ─────────────────────────
  const [mobRoster,setMobRoster]=useState([]);
  const mobUnsub=useRef(null);
  useEffect(()=>{
    if(!(myP&&myP.isGM))return;
    mobUnsub.current=DB.sub('cp20/mobroster',val=>{
      if(!val){setMobRoster([]);return;}
      const ids=Array.isArray(val)?val.filter(Boolean):Object.values(val);
      Promise.all(ids.map(i=>DB.get('cp20/mobs/'+i))).then(ms=>setMobRoster(ms.filter(Boolean)));
    });
    return()=>mobUnsub.current?.();
  },[myP?.isGM]);

  const saveMob=async m=>{
    await DB.set('cp20/mobs/'+m.id,m);
    const cur=await DB.get('cp20/mobroster')||[];
    const ids=Array.isArray(cur)?cur:Object.values(cur);
    if(!ids.includes(m.id))await DB.set('cp20/mobroster',[...ids,m.id]);
    setMobRoster(r=>{const i=r.findIndex(x=>x.id===m.id);if(i>=0){const n=[...r];n[i]=m;return n;}return[...r,m];});
  };
  const onMobCreate=async(type)=>{
    const id=uid();
    const color=PCOLORS[Math.floor(Math.random()*PCOLORS.length)];
    let m;
    if(type==='blackice'){
      m={id,mobType:'blackice',handle:'Новый Лёд',color,strength:'',speedStat:'',hp:'',bugs:defBugs()};
    } else {
      m={id,mobType:'demon',handle:'Новый Демон',color,isGM:false,hp:'',
        stats:{int:'',iface:''},cyberdeck:{name:'',memory:'',speed_raw:'',defense:''},
        programs:[],bugs:defBugs()};
    }
    await saveMob(m);
    return id;
  };
  const onMobDelete=async(mobId)=>{
    const cur=await DB.get('cp20/mobroster')||[];
    const ids=(Array.isArray(cur)?cur:Object.values(cur)).filter(i=>i!==mobId);
    await DB.set('cp20/mobroster',ids);
    setMobRoster(r=>r.filter(x=>x.id!==mobId));
    setSel(s=>(s&&s.id===mobId)?{type:'player',id:myId}:s);
  };
  const onMobField=async(mob,field,val)=>{ await saveMob({...mob,[field]:val}); };

  // ── Unified entity resolution: player (self/other) or mob ──
  const target=(()=>{
    if(!sel) return myP;
    if(sel.type==='player'){
      if(sel.id===myId) return myP;
      return roster.find(p=>p.id===sel.id)||myP;
    }
    return mobRoster.find(m=>m.id===sel.id)||null;
  })();
  const isSelf=target&&target.id===myId;
  const canEdit=!!target&&(isSelf||!!myP?.isGM);
  const badge=(target&&!isSelf&&myP?.isGM)?(target.mobType?'GM УПРАВЛЯЕТ МОБОМ':'GM РЕДАКТИРУЕТ ИГРОКА'):null;

  const saveEntity=async e=>{
    if(e.mobType==='blackice'||e.mobType==='demon') await saveMob(e);
    else await saveP(e);
  };

  const onEntityStat=async(f,v)=>{ if(!target)return; await saveEntity({...target,stats:{...target.stats,[f]:v}}); };
  const onEntityDeck=async(f,v)=>{ if(!target)return; await saveEntity({...target,cyberdeck:{...target.cyberdeck,[f]:v}}); };
  const onEntityHp=async(v)=>{ if(!target)return; await saveEntity({...target,hp:v}); };
  const onEntitySaveProg=async prog=>{
    if(!target)return;
    const isNew=!prog.id;
    const p=isNew?{...prog,id:uid(),status:'active'}:prog;
    const progs=isNew?[...(target.programs||[]),p]:(target.programs||[]).map(x=>x.id===p.id?p:x);
    await saveEntity({...target,programs:progs});
    setModal(null);
  };
  const onEntityDelProg=async id=>{ if(!target)return; await saveEntity({...target,programs:(target.programs||[]).filter(p=>p.id!==id)}); };
  const onEntityCycle=async progId=>{
    if(!target)return;
    const progs=(target.programs||[]).map(p=>{if(p.id!==progId)return p;const i=SCYCLE.indexOf(p.status||'active');return{...p,status:SCYCLE[(i+1)%3]};});
    await saveEntity({...target,programs:progs});
  };
  const onEntityBug=async(bugId,val)=>{ if(!target)return; await saveEntity({...target,bugs:{...(target.bugs||defBugs()),[bugId]:Math.max(0,val)}}); };

  const addRandBugTo=async entity=>{
    const id=Math.floor(Math.random()*10)+1;
    const bugs={...(entity.bugs||defBugs())};
    bugs[id]=(bugs[id]||0)+1;
    const up={...entity,bugs};
    await saveEntity(up);
    await addLog(`⚠ ПРОВАЛ! Баг #${id} «${BUGS.find(b=>b.id===id)?.label}» +1 (стаков: ${bugs[id]})`,entity,'','fumble');
    return up;
  };
  const onEntityGlitch=async()=>{ if(!target)return; await addRandBugTo(target); };

  const asRollEntity=e=>({mobType:e.mobType||'player',stats:e.stats,programs:e.programs,bugs:e.bugs,strength:e.strength,speedStat:e.speedStat});

  const onEntityRollAtk=async(prog,manBonus)=>{
    if(!target)return null;
    const res=computeAttack(asRollEntity(target),prog,manBonus);
    await addLog(`⚔ АТАКА «${prog.name}»`,target,JSON.stringify(res),res.isCrit?'crit':res.isFum?'fumble':'roll');
    if(res.isFum) await addRandBugTo(target);
    return res;
  };
  const onEntityRollInit=async manBonus=>{
    if(!target)return null;
    const res=computeInit(asRollEntity(target),manBonus);
    await addLog(`🎲 ИНИЦИАТИВА`,target,JSON.stringify(res),'roll');
    return res;
  };
  const onEntityRollDef=async manBonus=>{
    if(!target)return null;
    const res=computeDefense(asRollEntity(target),manBonus);
    await addLog(`🛡 ЗАЩИТА`,target,JSON.stringify(res),'roll');
    return res;
  };
  const onEntityRollGeneric=async manBonus=>{
    if(!target)return null;
    const res=computeGenericRoll(asRollEntity(target),manBonus);
    await addLog(`🎲 БРОСОК`,target,JSON.stringify(res),'roll');
    return res;
  };

  // ── Library install — installs onto whatever entity is currently open ──
  const onInstallFromLib=async(libProg,ver)=>{
    if(!target||!canEdit||target.mobType==='blackice')return;
    const newProg={
      id:uid(), name:`${libProg.name} v${ver.v}`, category:libProg.category, status:'active',
      price:ver.price||'', mu:ver.mu||'',
      hit_bonus:ver.hit_bonus||'', dmg_runners:ver.dmg_runners||'', dmg_programs:ver.dmg_programs||'',
      dv:ver.dv||'', spd_bonus:ver.spd_bonus||'',
      dmg_bonus_runners:'', dmg_bonus_programs:'', crit_mod:'', fumble_mod:'',
      detectDifficulty:ver.detectDifficulty||'', duration:ver.duration||'', activations:ver.activations||'',
      cooldown:ver.cooldown||'',
      description:[libProg.description||'', ver.diff?`Особенности: ${ver.diff}`:'', ver.effect?`Эффект: ${ver.effect}`:'']
        .filter(Boolean).join('\n'),
    };
    await saveEntity({...target,programs:[...(target.programs||[]),newProg]});
  };

  if(phase==='boot')return<div style={{position:'fixed',inset:0,display:'flex',alignItems:'center',justifyContent:'center',background:C.bg,fontFamily:C.fn,color:C.aml,fontSize:14,letterSpacing:4}}>ИНИЦИАЛИЗАЦИЯ...</div>;
  if(phase==='login')return<Login onLogin={onLogin}/>;

  return(
    <div style={{position:'fixed',inset:0,display:'flex',flexDirection:'column',background:C.bg,fontFamily:C.fn,color:C.tx}}>
      <TopBar myP={myP} onLogout={onLogout} onInit={()=>setModal({t:'init'})} onDef={()=>setModal({t:'def'})}
        onGlitch={onEntityGlitch} onRoll={()=>setModal({t:'roll'})} onLib={()=>setShowLib(l=>!l)} libActive={showLib}/>
      <div style={{flex:1,display:'flex',overflow:'hidden',minHeight:0}}>
        {myP?.isGM&&<JournalSidebar roster={roster} mobRoster={mobRoster} myId={myId} sel={sel} setSel={setSel}
          onCreateMob={onMobCreate} onDeleteMob={onMobDelete}/>}
        {target&&target.mobType==='blackice'&&<BlackIceEditor mob={target} onField={onMobField} onHp={onEntityHp}
          onDelete={onMobDelete} onAtk={()=>setModal({t:'atk',prog:{name:target.handle}})} isOwn={canEdit}/>}
        {target&&target.mobType!=='blackice'&&<div style={{flex:1,display:'flex',flexDirection:'column',overflow:'hidden',minWidth:0}}>
          {target.mobType==='demon'&&<div style={{background:C.pan,borderBottom:'1px solid '+C.brd,padding:'6px 18px',flexShrink:0}}>
            <button onClick={()=>onMobDelete(target.id)} style={SB(C.rdl+'55',C.rdl,{fontSize:12,padding:'4px 12px'})}>✕ УДАЛИТЬ МОБА</button>
          </div>}
          <Sheet profile={target} isOwn={canEdit} badge={badge}
            onStat={canEdit?onEntityStat:null} onDeck={canEdit?onEntityDeck:null}
            onHp={canEdit?onEntityHp:null}
            onAdd={canEdit?(()=>setModal({t:'prog',d:null})):null}
            onEdit={canEdit?(p=>setModal({t:'prog',d:p})):null}
            onDel={canEdit?onEntityDelProg:null} onCycle={canEdit?onEntityCycle:null}
            onAtk={canEdit?(p=>setModal({t:'atk',prog:p})):null}
            onBug={canEdit?onEntityBug:null}
            onRename={(target.mobType&&canEdit)?(v=>onMobField(target,'handle',v)):null}/>
        </div>}
        {!target&&<div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',fontSize:14,color:C.txd}}>Выберите нетраннера или моба слева</div>}
        <LogPanel logs={logs} logRef={logRef}
          onSendMsg={myP?((txt)=>addLog(`💬 ${txt}`,myP,'','info')):null}/>
      </div>

      {modal?.t==='prog'&&<Ov onClose={()=>setModal(null)}><ProgModal ini={modal.d} onSave={onEntitySaveProg} onClose={()=>setModal(null)}/></Ov>}
      {modal?.t==='atk'&&target&&<Ov onClose={()=>setModal(null)}>
        <AtkModal prog={modal.prog} entity={asRollEntity(target)} onRoll={onEntityRollAtk} onClose={()=>setModal(null)}/>
      </Ov>}
      {modal?.t==='init'&&target&&<Ov onClose={()=>setModal(null)}>
        <InitModal entity={asRollEntity(target)} onRoll={onEntityRollInit} onClose={()=>setModal(null)}/>
      </Ov>}
      {modal?.t==='def'&&target&&<Ov onClose={()=>setModal(null)}>
        <DefModal entity={asRollEntity(target)} onRoll={onEntityRollDef} onClose={()=>setModal(null)}/>
      </Ov>}
      {modal?.t==='roll'&&target&&<Ov onClose={()=>setModal(null)}>
        <RollModal entity={asRollEntity(target)} onRoll={onEntityRollGeneric} onClose={()=>setModal(null)}/>
      </Ov>}

      {showLib&&<LibraryPanel onClose={()=>setShowLib(false)} onInstall={(target&&canEdit&&target.mobType!=='blackice')?onInstallFromLib:null} isGM={!!myP?.isGM}/>}
    </div>
  );
}

function Ov({children,onClose}){
  return<div onClick={e=>{if(e.target===e.currentTarget)onClose();}}
    style={{position:'fixed',inset:0,background:'rgba(0,0,0,0.9)',display:'flex',alignItems:'center',justifyContent:'center',zIndex:100,padding:16,overflowY:'auto'}}>
    {children}
  </div>;
}

// ── Login ──────────────────────────────────────────────
function Login({onLogin}){
  const [h,setH]=useState('');const [col,setCol]=useState(PCOLORS[0]);
  const [gm,setGm]=useState(false);const [pw,setPw]=useState('');const [err,setErr]=useState('');
  const sub=()=>{if(!h.trim()){setErr('Введите позывной');return;}if(gm&&pw!==GM_PASS){setErr('Неверный пароль GM');return;}onLogin({handle:h.trim(),color:col,isGM:gm});};
  const fbOk=window.USE_FIREBASE;
  return<div style={{position:'fixed',inset:0,display:'flex',alignItems:'center',justifyContent:'center',background:C.bg,fontFamily:C.fn}}>
    <div style={{width:440}}>
      <div style={{textAlign:'center',marginBottom:14}}>
        <div style={{fontFamily:C.or,fontSize:36,color:C.aml,letterSpacing:7,fontWeight:700,textShadow:'0 0 28px '+C.aml+'66'}}>CYBERPUNK</div>
        <div style={{fontFamily:C.or,fontSize:17,color:C.rdl,letterSpacing:10,marginTop:4,textShadow:'0 0 18px '+C.rdl+'55'}}>2020</div>
        <div style={{fontSize:11,color:C.txd,letterSpacing:4,marginTop:12}}>MATRIX CALCULATOR // NETRUNNER EDITION</div>
