        </div>
      </div>)}
    </div>
    <div style={{padding:'14px 24px',borderTop:'1px solid '+C.brd,display:'flex',gap:10,background:C.pan2,flexShrink:0}}>
      <button onClick={save} style={{...SB(col,col,{flex:1,padding:'11px',fontSize:15,letterSpacing:2})}}>✓ СОХРАНИТЬ (для всех)</button>
      <button onClick={onCancel} style={SB(C.brd,TX2,{padding:'11px 20px',fontSize:14})}>ОТМЕНА</button>
    </div>
  </div>;
}


// ══════════════════════════════════════════════════════
//   JOURNAL SIDEBAR (GM only, always visible on main screen)
//   Folders: Игроки · Чёрный Лёд · Демоны/Ранеры
// ══════════════════════════════════════════════════════
const FOLDER_META={
  players:{label:'ИГРОКИ', color:C.aml, icon:'👤'},
  blackice:{label:'ЧЁРНЫЙ ЛЁД', color:C.cyl, icon:'❄'},
  demon:{label:'ДЕМОНЫ / РАНЕРЫ', color:C.prp, icon:'👹'},
};

function JournalSidebar({roster,mobRoster,myId,sel,setSel,onCreateMob,onDeleteMob}){
  const [open,setOpen]=useState({players:true,blackice:true,demon:true});
  const biList=mobRoster.filter(m=>m.mobType==='blackice');
  const dmList=mobRoster.filter(m=>m.mobType==='demon');
  const players=roster;

  const create=async(type)=>{
    const id=await onCreateMob(type);
    setSel({type,id});
    setOpen(o=>({...o,[type]:true}));
  };
  const toggleFolder=k=>setOpen(o=>({...o,[k]:!o[k]}));

  const Folder=({fk,list,renderRow,canCreate})=>{
    const meta=FOLDER_META[fk];
    const isOpen=open[fk];
    return<div>
      <div onClick={()=>toggleFolder(fk)} style={{padding:'9px 14px',fontSize:12,color:meta.color,letterSpacing:2,background:C.pan2,borderBottom:'1px solid '+C.brd,display:'flex',justifyContent:'space-between',alignItems:'center',cursor:'pointer',userSelect:'none'}}>
        <span>{isOpen?'▾':'▸'} 📁 {meta.icon} {meta.label}</span><span>{list.length}</span>
      </div>
      {isOpen&&<>
        {list.map(renderRow)}
        {canCreate&&<div style={{padding:'6px 10px'}}>
          <button onClick={()=>create(fk)} style={{...SB(meta.color,meta.color,{width:'100%',padding:'6px',fontSize:12,letterSpacing:1})}}>+ Добавить</button>
        </div>}
      </>}
    </div>;
  };

  const Row=({active,color,name,tag,onClick})=>(
    <button onClick={onClick}
      style={{width:'100%',background:active?color+'18':'transparent',border:'none',borderLeft:active?'3px solid '+color:'3px solid transparent',
        color:active?color:C.txb,fontFamily:C.fn,fontSize:14,padding:'9px 14px 9px 26px',cursor:'pointer',textAlign:'left',display:'flex',alignItems:'center',gap:8}}>
      <div style={{width:7,height:7,borderRadius:'50%',background:color,flexShrink:0}}/>
      <span style={{overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap',flex:1}}>{name}</span>
      {tag&&<span style={{fontSize:10,color:TX2,flexShrink:0}}>{tag}</span>}
    </button>
  );

  return<div style={{width:230,background:C.pan,borderRight:'1px solid '+C.brd,display:'flex',flexDirection:'column',flexShrink:0}}>
    <div style={{padding:'10px 14px',borderBottom:'1px solid '+C.brd}}>
      <div style={{fontSize:13,color:C.prp,letterSpacing:3,fontWeight:'bold'}}>🗂 ЖУРНАЛ</div>
      <div style={{fontSize:11,color:TX2,marginTop:2}}>Игроки и мобы</div>
    </div>
    <div style={{flex:1,overflowY:'auto'}}>
      <Folder fk="players" list={players} canCreate={false} renderRow={p=>(
        <Row key={p.id} active={sel?.type==='player'&&sel.id===p.id} color={p.color} name={p.handle} tag={p.id===myId?'вы':'игрок'}
          onClick={()=>setSel({type:'player',id:p.id})}/>
      )}/>
      <Folder fk="blackice" list={biList} canCreate={true} renderRow={m=>(
        <Row key={m.id} active={sel?.type==='blackice'&&sel.id===m.id} color={m.color} name={m.handle}
          onClick={()=>setSel({type:'blackice',id:m.id})}/>
      )}/>
      <Folder fk="demon" list={dmList} canCreate={true} renderRow={m=>(
        <Row key={m.id} active={sel?.type==='demon'&&sel.id===m.id} color={m.color} name={m.handle}
          onClick={()=>setSel({type:'demon',id:m.id})}/>
      )}/>
    </div>
  </div>;
}

// ── Black Ice editor (shown in main content area when selected) ──
function BlackIceEditor({mob,onField,onHp,onDelete,onAtk,isOwn}){
  return<div style={{flex:1,display:'flex',flexDirection:'column',overflow:'hidden'}}>
    <div style={{background:C.pan,borderBottom:'1px solid '+C.brd,padding:'10px 18px',display:'flex',alignItems:'center',gap:12,flexShrink:0,flexWrap:'wrap'}}>
      <div style={{width:13,height:13,borderRadius:'50%',background:mob.color,boxShadow:'0 0 12px '+mob.color,flexShrink:0}}/>
      {isOwn?<RenameField value={mob.handle} onChange={v=>onField(mob,'handle',v)} color={mob.color}/>
        :<span style={{fontFamily:C.or,fontSize:19,color:mob.color,letterSpacing:2}}>{mob.handle}</span>}
      <span style={{fontSize:12,color:C.cyl,border:'1px solid '+C.cyl+'55',padding:'2px 8px'}}>❄ ЧЁРНЫЙ ЛЁД</span>
      <div style={{marginLeft:'auto',display:'flex',alignItems:'center',gap:8}}>
        <span style={{fontSize:12,color:TX2,letterSpacing:1}}>HP</span>
        <input value={mob.hp||''} onChange={e=>onHp(e.target.value)} placeholder="30"
          style={{...SI({fontSize:16,padding:'4px 8px',width:70}),textAlign:'center',color:C.rdll,fontWeight:'bold'}}/>
      </div>
      <button onClick={()=>onDelete(mob.id)} style={SB(C.rdl+'55',C.rdl,{fontSize:12,padding:'5px 12px'})}>✕ УДАЛИТЬ</button>
    </div>
    <div style={{flex:1,overflowY:'auto',padding:18}}>
      <Box color={C.cyl} label="// ПАРАМЕТРЫ ЛЬДА">
        <G2>
          <SF label="Сила Программы" v={mob.strength} onChange={v=>onField(mob,'strength',v)} hint="0 / 1d6+4"/>
          <SF label="Скорость" v={mob.speedStat} onChange={v=>onField(mob,'speedStat',v)} hint="0 / 1d6"/>
        </G2>
      </Box>
      <div style={{marginTop:16}}>
        <button onClick={onAtk} style={{...SB(C.rdl,C.rdl,{fontSize:14,padding:'8px 20px',letterSpacing:1})}}>⚔ АТАКА</button>
        <div style={{fontSize:12,color:TX2,marginTop:8}}>Глюк / Инициатива / Защита — кнопки в верхней панели действуют на этот Лёд, пока он выбран в Журнале.</div>
      </div>
      <div style={{marginTop:16}}>
        <BugsTab bugs={mob.bugs||defBugs()} isOwn={true} onBug={(id,v)=>onField(mob,'bugs',{...(mob.bugs||defBugs()),[id]:Math.max(0,v)})}/>
      </div>
    </div>
  </div>;
}

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
</body>
</html>
