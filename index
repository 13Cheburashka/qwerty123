// ─── STORAGE (Firebase + localStorage fallback) ───────
const HAS_WS=typeof window!=='undefined';
let FDB=null;
try{
  if(window.USE_FIREBASE&&typeof firebase!=='undefined'){
    firebase.initializeApp(window.FIREBASE_CONFIG);
    FDB=firebase.database();
  }
}catch(e){console.warn('Firebase:',e);}

const LS_SET=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v));}catch{}};
const LS_GET=(k)=>{try{const v=localStorage.getItem(k);return v?JSON.parse(v):null;}catch{return null;}};
const path2key=p=>p.replace(/\//g,'__');

const DB={
  get:async p=>{
    if(FDB){const s=await FDB.ref(p).once('value');return s.val();}
    return LS_GET(path2key(p));
  },
  set:async(p,v)=>{
    if(FDB)return FDB.ref(p).set(v);
    LS_SET(path2key(p),v);
  },
  sub:(p,cb)=>{
    if(FDB){
      const ref=FDB.ref(p);
      ref.on('value',s=>cb(s.val()));
      return()=>ref.off();
    }
    cb(LS_GET(path2key(p)));
    const t=setInterval(()=>cb(LS_GET(path2key(p))),2500);
    return()=>clearInterval(t);
  }
};

// ─── DICE ENGINE ───────────────────────────────────────
function roll(expr){
  const s=String(expr??'').trim();
  if(!s||s==='—'||s==='-')return{val:0,str:'0'};
  const n=+s;if(!isNaN(n))return{val:n,str:s};
  if(!/^[\d\s+\-*/d().]+$/i.test(s))return{val:0,str:'ERR'};
  let d=s;
  const ev=s.replace(/(\d+)d(\d+)/gi,(m,a,b)=>{
    const rs=Array.from({length:Math.min(+a,20)},()=>Math.floor(Math.random()*Math.min(+b,9999))+1);
    d=d.replace(m,'['+rs.join('+')+']');return rs.reduce((x,y)=>x+y,0);
  });
  try{const v=Function('"use strict";return('+ev+')')();return{val:Math.round(v*100)/100,str:d};}
  catch{return{val:0,str:'ERR'};}
}
const pn=v=>{const n=parseFloat(v);return isNaN(n)?0:n;};
const uid=()=>Math.random().toString(36).slice(2,8).toUpperCase();
const ts=()=>new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit',second:'2-digit'});

// ─── COMPUTED STATS ────────────────────────────────────
const actP=programs=>(programs||[]).filter(p=>p.status==='active');
const duAct=programs=>actP(programs).filter(p=>p.category==='defensive'||p.category==='support');

// Global crit/fumble thresholds: only defensive/support programs affect the deck-wide value
function globalCrit(programs){
  return Math.max(0,Math.min(10,10+duAct(programs).reduce((s,p)=>s+(+p.crit_mod||0),0)));
}
function globalFumble(programs,bugs){
  return Math.max(0,Math.min(10,1+duAct(programs).reduce((s,p)=>s+(+p.fumble_mod||0),0)+(bugs?.[6]||0)));
}
// Per-attacking-program threshold = global + that program's own mod (does NOT change the global value)
function atkCrit(prog,programs){
  return Math.max(0,Math.min(10,globalCrit(programs)+(+prog.crit_mod||0)));
}
function atkFumble(prog,programs,bugs){
  return Math.max(0,Math.min(10,globalFumble(programs,bugs)+(+prog.fumble_mod||0)));
}
// DV is now a BONUS to defense (not a static override)
function defenseBonus(programs,bugs){
  return duAct(programs).reduce((s,p)=>s+pn(p.dv),0)-(bugs?.[8]||0);
}
function defenseValue(stats,programs,bugs){
  return pn(stats?.int)+pn(stats?.iface)+defenseBonus(programs,bugs);
}
function calcSpeed(stats,programs,bugs){
  return pn(stats?.int)+duAct(programs).reduce((s,p)=>s+pn(p.spd_bonus),0)-(bugs?.[1]||0)*3;
}
const bugHitPen=bugs=>(bugs?.[2]||0);
const bugDmgPen=bugs=>(bugs?.[3]||0);

// ─── GENERIC ROLL COMPUTATION (shared: players, demons, black ice) ───
// entity = {mobType:'player'|'demon'|'blackice', stats, programs, bugs, strength, speedStat}
function computeAttack(entity, prog, manualBonus){
  const d10=roll('1d10');
  const man=roll(manualBonus||'0');
  if(entity.mobType==='blackice'){
    const str=pn(entity.strength);
    let total=Math.round((d10.val+str+man.val)*100)/100;
    const expr=`1d10=[${d10.val}] + СИЛА(${entity.strength||0})`+(man.val?` + Бонус[${man.str}]`:'');
    return{hitTotal:total,hitExpr:expr,isCrit:false,isFum:false,d10val:d10.val,critT:null,fumT:null,dmgR:null,dmgP:null};
  }
  const programs=entity.programs||[];
  const bugs=entity.bugs||defBugs();
  const critT=atkCrit(prog,programs), fumT=atkFumble(prog,programs,bugs);
  const iface=roll(entity.stats?.iface||'0');
  const intR=roll(entity.stats?.int||'0');
  const ownHit=roll(prog.hit_bonus||'0');
  const hitMods=duAct(programs).filter(p=>p.hit_bonus&&String(p.hit_bonus).trim());
  const hitR=hitMods.map(p=>({name:p.name,r:roll(p.hit_bonus)}));
  const hp=bugHitPen(bugs);
  let ht=d10.val+intR.val+iface.val+ownHit.val+hitR.reduce((s,m)=>s+m.r.val,0)-hp+man.val;
  ht=Math.round(ht*100)/100;
  const isCrit=d10.val>=critT, isFum=d10.val<=fumT;

  const dp=bugDmgPen(bugs);
  const dRmods=duAct(programs).filter(p=>p.dmg_bonus_runners&&String(p.dmg_bonus_runners).trim());
  const dPmods=duAct(programs).filter(p=>p.dmg_bonus_programs&&String(p.dmg_bonus_programs).trim());
  let dmgR=null,dmgP=null;
  if(prog.dmg_runners){
    const b=roll(prog.dmg_runners);
    const br=dRmods.map(p=>({name:p.name,r:roll(p.dmg_bonus_runners)}));
    const tot=Math.max(1,Math.round((b.val+br.reduce((s,m)=>s+m.r.val,0)-dp)*100)/100);
    dmgR={total:tot,parts:[b.str,...br.map(m=>'+'+m.name+'['+m.r.str+']'),dp?'-Bug#3['+dp+']':''].filter(Boolean)};
  }
  if(prog.dmg_programs){
    const b=roll(prog.dmg_programs);
    const br=dPmods.map(p=>({name:p.name,r:roll(p.dmg_bonus_programs)}));
    const tot=Math.max(1,Math.round((b.val+br.reduce((s,m)=>s+m.r.val,0)-dp)*100)/100);
    dmgP={total:tot,parts:[b.str,...br.map(m=>'+'+m.name+'['+m.r.str+']'),dp?'-Bug#3['+dp+']':''].filter(Boolean)};
  }
  const ownHitTxt=(prog.hit_bonus&&String(prog.hit_bonus).trim()&&prog.hit_bonus!=='0')?` + Прог.бонус[${ownHit.str}]`:'';
  const hitExpr=`1d10=[${d10.val}] + INT[${intR.str}] + IFACE[${iface.str}]`+ownHitTxt
    +hitR.map(m=>` + ${m.name}[${m.r.str}]`).join('')
    +(hp?` − Bug#2[${hp}]`:'')
    +(man.val?` + Бонус[${man.str}]`:'');
  return{hitTotal:ht,hitExpr,isCrit,isFum,d10val:d10.val,critT,fumT,dmgR,dmgP};
}

function computeDefense(entity, manualBonus){
  const man=roll(manualBonus||'0');
  if(entity.mobType==='blackice'){
    const d10=roll('1d10');
    const str=pn(entity.strength);
    const total=Math.round((str+d10.val+man.val)*100)/100;
    const expr=`СИЛА(${entity.strength||0}) + 1d10=[${d10.val}]`+(man.val?` + Бонус[${man.str}]`:'');
    return{total,expr,isRoll:true,d10val:d10.val};
  }
  const programs=entity.programs||[];
  const bugs=entity.bugs||defBugs();
  const bonus=defenseBonus(programs,bugs);
  const total=Math.round((pn(entity.stats?.int)+pn(entity.stats?.iface)+bonus+man.val)*100)/100;
  const dvMods=duAct(programs).filter(p=>p.dv&&String(p.dv).trim());
  const expr=`INT(${entity.stats?.int||0}) + IFACE(${entity.stats?.iface||0})`
    +dvMods.map(p=>` + ${p.name}[${p.dv}]`).join('')
    +((bugs?.[8]||0)?` − Bug#8[${bugs[8]}]`:'')
    +(man.val?` + Бонус[${man.str}]`:'');
  return{total,expr,isRoll:false};
}

function computeGenericRoll(entity, manualBonus){
  const d10=roll('1d10');
  const man=roll(manualBonus||'0');
  const intR=roll(entity.stats?.int||'0');
  const ifaceR=roll(entity.stats?.iface||'0');
  const total=Math.round((d10.val+intR.val+ifaceR.val+man.val)*100)/100;
  const expr=`1d10=[${d10.val}] + INT[${intR.str}] + IFACE[${ifaceR.str}]`+(man.val?` + Бонус[${man.str}]`:'');
  return{total,expr,d10val:d10.val};
}

function computeInit(entity, manualBonus){
  const d10=roll('1d10');
  const man=roll(manualBonus||'0');
  if(entity.mobType==='blackice'){
    const spd=pn(entity.speedStat);
    const total=Math.round((d10.val+spd+man.val)*100)/100;
    const expr=`1d10=[${d10.val}] + СКОРОСТЬ(${entity.speedStat||0})`+(man.val?` + Бонус[${man.str}]`:'');
    return{total,expr};
  }
  const programs=entity.programs||[];
  const bugs=entity.bugs||defBugs();
  const intR=roll(entity.stats?.int||'0');
  const spdM=duAct(programs).filter(p=>p.spd_bonus&&String(p.spd_bonus).trim());
  const spdR=spdM.map(p=>({name:p.name,r:roll(p.spd_bonus)}));
  const bs=(bugs[1]||0)*3;
  let total=d10.val+intR.val+spdR.reduce((s,m)=>s+m.r.val,0)-bs+man.val;
  total=Math.round(total*100)/100;
  const expr=`1d10=[${d10.val}] + INT[${intR.str}]`
    +spdR.map(m=>` + ${m.name}[${m.r.str}]`).join('')
    +(bs?` − Bug#1[${bs}]`:'')
    +(man.val?` + Бонус[${man.str}]`:'');
  return{total,expr};
}

