      <div style={{width:13,height:13,borderRadius:'50%',background:profile.color,boxShadow:'0 0 12px '+profile.color,flexShrink:0}}/>
      {onRename?<RenameField value={profile.handle} onChange={onRename} color={profile.color}/>
        :<span style={{fontFamily:C.or,fontSize:19,color:profile.color,letterSpacing:2}}>{profile.handle}</span>}
      {badge&&<span style={{fontSize:12,color:TX2,border:'1px solid '+C.brd,padding:'2px 10px',marginLeft:4}}>{badge}</span>}
      {profile.isGM&&<span style={{fontSize:12,color:C.rdl,border:'1px solid '+C.rdl+'55',padding:'2px 8px'}}>GM</span>}
      {profile.mobType==='demon'&&<span style={{fontSize:12,color:C.prp,border:'1px solid '+C.prp+'55',padding:'2px 8px'}}>ДЕМОН</span>}
      {profile.mobType&&<div style={{marginLeft:'auto',display:'flex',alignItems:'center',gap:8}}>
        <span style={{fontSize:12,color:TX2,letterSpacing:1}}>HP</span>
        <input value={profile.hp||''} onChange={e=>onHp&&onHp(e.target.value)} disabled={!isOwn} placeholder="30"
          style={{...SI({fontSize:16,padding:'4px 8px',width:70}),textAlign:'center',color:C.rdll,fontWeight:'bold'}}/>
      </div>}
    </div>
    <div style={{display:'flex',borderBottom:'1px solid '+C.brd,background:C.pan,flexShrink:0}}>
      {tabs.map(t=><button key={t.id} onClick={()=>setTab(t.id)} style={{background:'transparent',border:'none',borderBottom:tab===t.id?'2px solid '+C.aml:'2px solid transparent',color:tab===t.id?C.aml:TX2,fontFamily:C.fn,fontSize:13,letterSpacing:2,padding:'11px 20px',cursor:'pointer'}}>{t.lb}</button>)}
    </div>
    <div style={{flex:1,overflowY:'auto',padding:18}}>
      {tab==='deck'&&<DeckTab p={profile} isOwn={isOwn} onStat={onStat} onDeck={onDeck} gCrit={gCrit} gFum={gFum} defVal={defVal} defBonus={defBonus} spd={spd} usedMu={usedMu} totMu={totMu} ovf={ovf}/>}
      {tab==='progs'&&<ProgsTab atkP={atkP} defP={defP} utlP={utlP} isOwn={isOwn} onAdd={onAdd} onEdit={onEdit} onDel={onDel} onCycle={onCycle} onAtk={onAtk}/>}
