// ── Program Card ───────────────────────────────────────
function PC({prog,isOwn,onEdit,onDel,onCycle,onAtk}){
  const cc=CATC[prog.category];
  const st=prog.status||'active';
  const sc=SCOL[st],isAct=st==='active',isAtk=prog.category==='attacking';
  const hasAtkStats=isAtk&&(prog.hit_bonus||prog.dmg_runners||prog.dmg_programs);
  const hasDefUtil=(prog.category==='defensive'||prog.category==='support')&&(prog.dv||prog.spd_bonus||prog.hit_bonus||prog.dmg_bonus_runners||prog.dmg_bonus_programs);
  const hasCM=prog.crit_mod||prog.fumble_mod;
  const hasGeneric=prog.cooldown||prog.duration||prog.activations||prog.detectDifficulty;
  return<div style={{background:C.pan2,border:'1px solid '+(isAct?cc+'55':C.brd),marginBottom:8,opacity:isAct?1:0.48,transition:'all 0.15s'}}>
    <div style={{display:'flex'}}>
      <div style={{width:4,background:isAct?cc:sc,flexShrink:0}}/>
      <div style={{flex:1,padding:'10px 13px'}}>
        <div style={{display:'flex',alignItems:'flex-start',gap:10,marginBottom:6,flexWrap:'wrap'}}>
          <span style={{fontSize:15,color:isAct?C.txb:TX2,fontWeight:'bold',flex:1}}>{prog.name||'Без названия'}</span>
          <span style={{fontSize:10,color:cc,border:'1px solid '+cc+'44',padding:'2px 8px',flexShrink:0}}>{CATL[prog.category]}</span>
          {prog.mu&&<span style={{fontSize:12,color:TX2}}>MU:{prog.mu}</span>}
          {prog.price&&<span style={{fontSize:12,color:TX2}}>eb:{prog.price}</span>}
        </div>
        {hasAtkStats&&<Row>{prog.hit_bonus&&<KV l="ПОП" v={prog.hit_bonus} c={C.aml}/>}{prog.dmg_runners&&<KV l="УРН.РАН" v={prog.dmg_runners} c={C.rdl}/>}{prog.dmg_programs&&<KV l="УРН.ПРГ" v={prog.dmg_programs} c={C.org}/>}</Row>}
        {hasDefUtil&&<Row>{prog.dv&&<KV l="ЗАЩ+" v={prog.dv} c={C.gnl}/>}{prog.spd_bonus&&<KV l="СКР+" v={prog.spd_bonus} c={C.cyl}/>}{prog.hit_bonus&&<KV l="ПОП+" v={prog.hit_bonus} c={C.aml}/>}{prog.dmg_bonus_runners&&<KV l="УРН.РАН+" v={prog.dmg_bonus_runners} c={C.rdl}/>}{prog.dmg_bonus_programs&&<KV l="УРН.ПРГ+" v={prog.dmg_bonus_programs} c={C.org}/>}</Row>}
        {hasCM&&<Row>{prog.crit_mod&&<KV l="КРИТ МОД" v={(+prog.crit_mod>0?'+':'')+prog.crit_mod} c={C.aml}/>}{prog.fumble_mod&&<KV l="ПРОВАЛ МОД" v={(+prog.fumble_mod>0?'+':'')+prog.fumble_mod} c={C.rdl}/>}</Row>}
        {hasGeneric&&<Row>{prog.detectDifficulty&&<KV l="ОБНАРУЖ" v={prog.detectDifficulty} c={C.cyl}/>}{prog.duration&&<KV l="ДЛИТ" v={prog.duration} c={TX2}/>}{prog.activations&&<KV l="АКТИВ" v={prog.activations} c={TX2}/>}{prog.cooldown&&<KV l="ПЕРЕЗАРЯД" v={prog.cooldown} c={TX2}/>}</Row>}
        {prog.description&&<div style={{fontSize:12,color:TX2,borderTop:'1px solid '+C.brd+'88',paddingTop:6,marginTop:6,lineHeight:1.7,whiteSpace:'pre-wrap'}}>{prog.description}</div>}
        {isOwn?<div style={{display:'flex',gap:7,marginTop:10,flexWrap:'wrap',alignItems:'center'}}>
          {isAtk&&onAtk&&isAct&&<button onClick={()=>onAtk(prog)} style={{...SB(cc,cc,{fontSize:13,padding:'5px 16px',letterSpacing:2})}}>⚔ АТАКА</button>}
          <button onClick={()=>onCycle(prog.id)} style={{...SB(sc,sc,{fontSize:12,padding:'5px 14px'})}}>{SLBL[st]}</button>
          <button onClick={()=>onEdit(prog)} style={SB(C.brdl,C.tx,{fontSize:13,padding:'5px 11px'})}>✎</button>
          <button onClick={()=>onDel(prog.id)} style={SB(C.rdl+'55',C.rdl,{fontSize:13,padding:'5px 11px'})}>✕</button>
        </div>:<div style={{marginTop:6,fontSize:13,color:sc}}>{SLBL[st]}</div>}
      </div>
    </div>
  </div>;
}
function Row({children}){return<div style={{display:'flex',gap:16,marginBottom:6,flexWrap:'wrap'}}>{children}</div>;}
function KV({l,v,c}){return<div style={{display:'flex',alignItems:'baseline',gap:5}}><span style={{fontSize:11,color:TX2,letterSpacing:1}}>{l}:</span><span style={{fontSize:14,color:c||C.txb,fontFamily:C.fn}}>{v}</span></div>;}

// ── Bugs Tab ───────────────────────────────────────────
function BugsTab({bugs,isOwn,onBug}){
  return<div>
