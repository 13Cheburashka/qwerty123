// ── Shared layout ───────────────────────────────────────
function Box({color,label,children}){return<div style={{background:C.pan,border:'1px solid '+C.brd}}><div style={{padding:'9px 16px',borderBottom:'1px solid '+C.brd,background:C.pan2}}><span style={{fontSize:12,color:color||C.aml,letterSpacing:3}}>{label}</span></div><div style={{padding:'14px 16px'}}>{children}</div></div>;}
function G2({children}){return<div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(170px,1fr))',gap:'0 22px'}}>{children}</div>;}
function G4({children}){return<div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(148px,1fr))',gap:'4px 18px'}}>{children}</div>;}
function AS({label,val,c,sub}){return<div style={{marginBottom:12}}><div style={{fontSize:11,color:TX2,letterSpacing:2,marginBottom:5,textTransform:'uppercase'}}>{label}</div><div style={{fontSize:25,color:c||C.txb,fontFamily:C.fn}}>{val}</div>{sub&&<div style={{fontSize:11,color:TX2,marginTop:2}}>{sub}</div>}</div>;}
function SF({label,v,onChange,dis,hint}){
  const [ed,setEd]=useState(false);
  const [val,setVal]=useState(v||'');
  useEffect(()=>setVal(v||''),[v]);
  const commit=()=>{onChange&&onChange(val);setEd(false);};
  return<div style={{marginBottom:12}}><div style={{fontSize:13,color:TX2,letterSpacing:2,marginBottom:7,textTransform:'uppercase'}}>{label}</div>
    {!dis&&ed?<input autoFocus value={val} onChange={e=>setVal(e.target.value)} onBlur={commit}
        onKeyDown={e=>{if(e.key==='Enter')commit();if(e.key==='Escape'){setVal(v||'');setEd(false);}}}
        placeholder={hint||'0 / 1d6+2'} style={SI({fontSize:15})}/>
      :<div onClick={()=>!dis&&setEd(true)} style={{cursor:dis?'default':'pointer',display:'flex',alignItems:'center',gap:9}}>
          <span style={{fontSize:15,color:val?C.txb:'#4a5e70',borderBottom:dis?'none':'1px dotted '+C.brdl,padding:'2px 2px'}}>{val||<span style={{fontSize:12,color:'#4a5e70'}}>—</span>}</span>
          {!dis&&<span style={{fontSize:11,color:C.brdl}}>✎</span>}
        </div>}
  </div>;
}


// ── Program Modal (create/edit a program directly on a sheet) ──
function ProgModal({ini,onSave,onClose}){
  const def={name:'',category:'attacking',status:'active',price:'',mu:'',
    hit_bonus:'',dmg_runners:'',dmg_programs:'',crit_mod:'',fumble_mod:'',description:'',dv:'',
    detectDifficulty:'',duration:'',activations:'',cooldown:'',
    has_spd:false,has_hit:false,has_dr:false,has_dp:false,spd_bonus:'',dmg_bonus_runners:'',dmg_bonus_programs:''};
  const [p,setP]=useState(()=>ini
    ?{...def,...ini,has_spd:!!ini.spd_bonus,has_hit:!!(ini.category!=='attacking'&&ini.hit_bonus),has_dr:!!ini.dmg_bonus_runners,has_dp:!!ini.dmg_bonus_programs}
    :{...def});
  const s=(k,v)=>setP(x=>({...x,[k]:v}));
  const cc=CATC[p.category];
  const isModCategory=p.category==='defensive'||p.category==='support';
  const hp='число или dice: 1d6, 1d10+3';
  const save=()=>{
    if(!p.name.trim())return;
    const o={...p};
    if(o.category!=='defensive'&&o.category!=='support'){
      if(!o.has_spd)o.spd_bonus='';
    } else {
      // def/support: hit_bonus is a checkbox-gated deck-wide bonus
      if(!o.has_hit)o.hit_bonus='';
      if(!o.has_spd)o.spd_bonus='';
    }
    if(o.category!=='attacking'){o.dmg_runners='';o.dmg_programs='';}
    if(!o.has_dr)o.dmg_bonus_runners='';
    if(!o.has_dp)o.dmg_bonus_programs='';
    delete o.has_spd;delete o.has_hit;delete o.has_dr;delete o.has_dp;
    onSave(o);
  };
